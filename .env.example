# The service's settings (internal/platform/config). Copy to .env for make run.
HTTP_ADDR=:8080
API_PREFIX=/api
LOG_LEVEL=debug
# The client's origin, so its browser may call with cookies (never "*").
CORS_ORIGINS=http://localhost:1420
SHUTDOWN_TIMEOUT=10s
# Postgres (make db-up starts this one).
DATABASE_URL=postgres://acme:acme@localhost:5432/acme?sslmode=disable
MIGRATE_ON_START=true
# Plain HTTP on a laptop: the cookies can't be Secure there. Never false in production.
COOKIE_SECURE=false
SESSION_LENGTH=8h
REFRESH_LENGTH=168h
